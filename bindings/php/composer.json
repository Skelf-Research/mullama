{
    "name": "mullama/mullama",
    "description": "High-performance PHP bindings for the Mullama LLM library - local inference with GGUF models",
    "type": "library",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://mullama.cognisoc.com",
    "support": {
        "issues": "https://github.com/cognisoc/mullama/issues",
        "source": "https://github.com/cognisoc/mullama/tree/main/bindings/php",
        "docs": "https://docs.cognisoc.com/mullama/bindings/php/"
    },
    "authors": [
        {
            "name": "Cognisoc",
            "email": "support@cognisoc.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Mullama\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mullama\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "minimum-stability": "stable",
    "keywords": [
        "llm",
        "llama",
        "gguf",
        "inference",
        "ai",
        "machine-learning"
    ]
}